{
    "name": "dragonmantank/cron-expression",
    "type": "library",
    "description": "CRON for PHP: Calculate the next or previous run date and determine if a CRON expression is due",
    "keywords": ["cron", "schedule"],
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Tankersley",
            "email": "chris@ctankersley.com",
            "homepage": "https://github.com/dragonmantank"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "dev-remote-test-2026-10-07 as 2.2.99",
        "phpunit/phpunit": "^11.5.43 || ^12.4",
        "phpstan/extension-installer": "dev-remote-test-2026-10-07 as 1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Cron\\": "src/Cron/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cron\\Tests\\": "tests/Cron/"
        }
    },
    "replace": {
        "mtdowling/cron-expression": "^1.0"
    },
    "scripts": {
        "phpstan": "phpstan analyze --no-progress --no-ansi --memory-limit=1G",
        "test": [
            "@php scripts/check-rename-residual.php",
            "@php scripts/check-cluster-pins.php",
            "phpunit --colors=never --no-coverage"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": true,
            "phpstan/extension-installer": true
        }
    }
}
